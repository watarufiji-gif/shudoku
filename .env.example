# このファイルは雛形です。値は入れず、コピーして .env を作成し実際のキーを設定してください。
# .env は .gitignore 済み（Gitに含めない）

# Resend
RESEND_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# microCMS 読み取り用
MICROCMS_SERVICE_DOMAIN=shudoku
MICROCMS_API_KEY=

# microCMS 書き込み用（create-book.js が使用）
# 必要な権限: コンテンツの登録(POST) / コンテンツの取得(一覧・詳細) / コンテンツのスケジュール設定を変更
# ※「スケジュール設定を変更」が無いと予約公開の自動設定ができず、管理画面で手動設定が必要になる
MICROCMS_WRITE_API_KEY=

# その他
DRY_RUN=true
SITE_URL=https://syudoku.com
MAIL_FROM=
ADMIN_PASSWORD=
RESEND_WEBHOOK_SECRET=
